PORT=3000
DATABASE_URL=postgres://postgres:<pass>@<shared-pg-host>:5432/reverb?sslmode=disable
TOKEN_SECRET=<openssl rand -hex 32>
# host.docker.internal does NOT resolve on this host (native Linux Docker,
# not Docker Desktop) — use the `coolify` network's gateway IP instead.
# Check with: docker network inspect coolify --format '{{(index .IPAM.Config 0).Gateway}}'
LM_STUDIO_BASE_URL=http://10.0.1.1:1235
# Only needed if LM Studio's "Require API Key" server setting is on.
LM_STUDIO_API_KEY=

# text-cmd (SMS) — shared secret, must match SERVICE_TOKEN on text-cmd
TEXT_CMD_BASE_URL=https://txt.cmdward.xyz
TEXT_CMD_SERVICE_TOKEN=<openssl rand -hex 32>

# Lifecmd2 (Calendar + personal & business Gmail) — shared secret, must match SERVICE_TOKEN on Lifecmd2
LIFECMD_BASE_URL=https://life.cmdward.xyz
LIFECMD_SERVICE_TOKEN=<openssl rand -hex 32>

# notify-cmd (WhatsApp/Messenger/Instagram, MacroDroid-fed) — shared secret,
# must match SERVICE_TOKEN on notify-cmd
NOTIFY_CMD_BASE_URL=https://notify.cmdward.xyz
NOTIFY_CMD_SERVICE_TOKEN=<must match notify-cmd's SERVICE_TOKEN>

# switch-craft-booking jobs feed — reuses its existing CAL_FEED_KEY
# (same key already used by /api/calendar.ics), not a new secret
SWITCHCRAFT_BASE_URL=https://switchcraft.cmdward.xyz
SWITCHCRAFT_FEED_KEY=<must match switch-craft-booking's CAL_FEED_KEY>
